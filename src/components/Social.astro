---
import { Icon } from 'astro-icon/components';
const { platform, username } = Astro.props;
---
<a href={`https://www.${platform}.com/${username}`} aria-label={platform}>
  <Icon name={`simple-icons:${platform}`} width="20" height="20" />
</a>

<style>
  a {
    color: var(--accent);
    display: inline-flex;
  }
</style>
