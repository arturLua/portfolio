---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const recentPosts = allPosts
  .sort((a: any, b: any) =>
    new Date(b.frontmatter.pubDate).valueOf() - new Date(a.frontmatter.pubDate).valueOf()
  )
  .slice(0, 3);

const pageTitle = "Artur Rebeschini";
---
<BaseLayout pageTitle={pageTitle}>
  <h1>Artur Rebeschini</h1>
  <p>it support · networks · cybersecurity</p>

  <p>
    I'm a 21 year old from Brazil. My day job is IT support and help desk 
    work, but most of what pulls my attention sits around networks and, lately, 
    cybersecurity.
  </p>

  <p class="links">
    <a href="/blog/">blog</a>
    <a href="https://github.com/arturLua" aria-label="github" title="github">
      <Icon name="simple-icons:github" width={20} height={20} />
    </a>
    <a href="https://www.linkedin.com/in/artur-rebeschini-18794b311/" aria-label="linkedin" title="linkedin">
      <Icon name="simple-icons:linkedin" width={20} height={20} />
    </a>
  </p>

  <section class="section">
    <h2 class="section-title">recent posts</h2>
    <ul class="cards">
      {recentPosts.map((post: any) => (
        <li class="card">
          <a href={post.url}>{post.frontmatter.title}</a>
          <p>
            <small>{new Date(post.frontmatter.pubDate).toISOString().slice(0, 10)}</small>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <div slot="aside" class="visual-placeholder">placeholder</div>
</BaseLayout>

<style>
  .links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .links a {
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
</style>
